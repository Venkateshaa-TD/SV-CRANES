# Copy this file to .env and fill in real values for your machine.
# Never commit .env — it is gitignored on purpose. Never put real
# credentials in THIS file — it is the checked-in template.

# --- Database (Supabase Postgres) ---------------------------------------
# Use the transaction-mode pooler (port 6543, pgbouncer=true) for the app
# itself — Supabase's session-mode pooler caps concurrent connections low
# (often 15), which a running app plus CLI tools can exhaust on their own.
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session-mode pooler or direct connection (port 5432) — used only for
# `prisma migrate` / `prisma db push`, which need a non-pooled connection.
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Auth.js ------------------------------------------------------------
# Generate a strong random secret, e.g.: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Base URL of the running application (used for callback URLs).
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- File storage ---------------------------------------------------------
# "local" writes to .uploads/ on disk (development only). A future
# S3-compatible provider would add its own keys here (bucket, region,
# access key, secret key) without changing any application code.
STORAGE_PROVIDER="local"
