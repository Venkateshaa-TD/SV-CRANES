// FleetView — Crane & Fleet Operations Management System
// Foundation schema. Later-phase models exist to establish relationships;
// their full workflows (billing engine, maintenance workflow, etc.) are
// deliberately not implemented yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer, transaction mode) connection — used by the running
  // app and by Prisma Client generally. Supabase's session-mode pooler
  // caps concurrent connections low (commonly 15), which the app can
  // exhaust on its own; the transaction pooler is built for many short
  // lived connections instead.
  url       = env("DATABASE_URL")
  // Direct/session connection — used only for schema migrations, which
  // need a non-pooled (or session-mode) connection.
  directUrl = env("DIRECT_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum UserRole {
  SUPER_ADMIN
  MANAGER
  ACCOUNTANT
  SUPERVISOR
  OPERATOR
}

enum VehicleStatus {
  WORKING
  IDLE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum VehicleCategory {
  CRANE
  TRUCK
  TRAILER
  PICKUP
  OTHER
}

enum ProjectStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Generic submit/review workflow status used by records that require
/// supervisor or manager approval before they affect reports/billing.
enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  CARD
  OTHER
}

enum BillingType {
  HOURLY
  DAILY
  MONTHLY
  FIXED
}

/// Workflow status for a BillingDraft: Operational Data -> Billing
/// Calculation -> DRAFT -> REVIEW -> APPROVED -> Invoice Generation
/// (INVOICED). REJECTED is a terminal dead-end requiring a new draft.
enum BillingDraftStatus {
  DRAFT
  REVIEW
  APPROVED
  REJECTED
  INVOICED
}

/// DEBIT increases a customer's outstanding balance (a manual charge);
/// CREDIT decreases it (a manual write-off/discount, or issuing credit for
/// an overpayment). Never a raw balance edit — always signed, reasoned,
/// and audited. See LedgerAdjustment.
enum LedgerAdjustmentType {
  DEBIT
  CREDIT
}

enum MaintenanceType {
  SCHEDULED
  BREAKDOWN
  INSPECTION
  OTHER
}

enum VehicleDocumentType {
  REGISTRATION
  INSURANCE
  FITNESS_CERTIFICATE
  PERMIT
  PUC
  OTHER
}

enum FuelType {
  DIESEL
  PETROL
  OTHER
}

enum NotificationType {
  GENERAL
  APPROVAL_REQUEST
  ALERT
  REMINDER
}

// =========================================================================
// COMPANY / TENANT
// =========================================================================

/// Single company today; modelled as a row (not hardcoded) so the schema
/// does not need to be redesigned if a second entity is ever added.
model Company {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  vehicles          Vehicle[]
  customers         Customer[]
  projects          Project[]
  expenseCategories ExpenseCategory[]
  invoices          Invoice[]
  payments          Payment[]
  auditLogs         AuditLog[]
  billingDrafts     BillingDraft[]
  invoiceSequences  InvoiceSequence[]
  ledgerAdjustments LedgerAdjustment[]
  closingPeriods    ClosingPeriod[]
}

// =========================================================================
// AUTH — USERS, ROLES, PERMISSIONS
// =========================================================================

model User {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  /// Optional short staff code (e.g. "OP-04"), unique per company.
  employeeCode String?
  role         UserRole
  isActive     Boolean   @default(true)
  image        String?
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  permissionOverrides UserPermission[]
  notifications       Notification[]
  auditLogs           AuditLog[]         @relation("AuditActor")
  fileAssets          FileAsset[]        @relation("FileUploadedBy")

  // Reverse relations for createdBy/updatedBy tracking are intentionally
  // omitted from User to avoid dozens of unnamed back-relations; the
  // createdById/updatedById fields below are plain string FKs (nullable)
  // recorded for audit purposes without forcing relational fan-out here.

  operatedDailyLogs DailyLog[]         @relation("DailyLogOperator")
  submittedExpenses Expense[]          @relation("ExpenseSubmittedBy")
  approvedExpenses  Expense[]          @relation("ExpenseApprovedBy")
  receivedPayments  Payment[]          @relation("PaymentReceivedBy")
  /// Vehicles this operator is the current primary assignee for. Assigned
  /// from the vehicle side (Vehicle.assignedOperatorId) — not editable here.
  assignedVehicles  Vehicle[]          @relation("VehicleAssignedOperator")
  reviewedBillingDrafts    BillingDraft[]     @relation("BillingDraftReviewedBy")
  approvedInvoices         Invoice[]          @relation("InvoiceApprovedBy")
  cancelledInvoices        Invoice[]          @relation("InvoiceCancelledBy")
  cancelledPayments        Payment[]          @relation("PaymentCancelledBy")
  createdLedgerAdjustments LedgerAdjustment[] @relation("LedgerAdjustmentCreatedBy")
  closedClosingPeriods     ClosingPeriod[]    @relation("ClosingPeriodClosedBy")
  reopenedClosingPeriods   ClosingPeriod[]    @relation("ClosingPeriodReopenedBy")

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([role])
}

/// Individual permission grant/revoke, layered on top of the role's default
/// permission set. Enables per-user exceptions (e.g. a small number of
/// users who may edit customer financial data) without hardcoding names or
/// forking role logic. See src/lib/auth/permissions.ts for the permission
/// key catalogue and how overrides are combined with role defaults.
model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  granted    Boolean  @default(true)
  reason     String?
  createdById String?
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

// =========================================================================
// FLEET
// =========================================================================

model Vehicle {
  id                 String          @id @default(cuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id])
  /// Short internal fleet code (e.g. "CR-01"), distinct from the display
  /// name and the government registration number.
  code               String?
  name               String
  registrationNumber String          @unique
  category           VehicleCategory @default(OTHER)
  capacityTons       Decimal?        @db.Decimal(10, 2)
  make               String?
  model              String?
  year               Int?
  fuelType           FuelType?
  status             VehicleStatus   @default(IDLE)
  /// Denormalized "latest known" readings. Advanced only via a MAX-style
  /// update alongside DailyLog creation (see src/lib/business/daily-log.ts)
  /// so a backdated historical log can never move these backwards.
  currentOdometer    Decimal?        @db.Decimal(12, 2)
  currentHourMeter   Decimal?        @db.Decimal(12, 2)
  assignedOperatorId String?
  assignedOperator   User?           @relation("VehicleAssignedOperator", fields: [assignedOperatorId], references: [id])
  purchaseDate       DateTime?
  purchaseAmount     Decimal?        @db.Decimal(12, 2)
  imageFileId        String?
  image              FileAsset?      @relation("VehicleImage", fields: [imageFileId], references: [id])
  notes              String?
  isActive           Boolean         @default(true)
  archivedAt         DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  projectAssignments ProjectVehicleAssignment[]
  dailyLogs          DailyLog[]
  fuelEntries        FuelEntry[]
  expenses           Expense[]
  maintenanceRecords MaintenanceRecord[]
  documents          VehicleDocument[]
  invoiceLines       InvoiceLine[]

  @@unique([companyId, code])
  // Nearly every vehicle list/dashboard query filters by companyId and
  // archivedAt (active vs archived) together, often with status too.
  @@index([companyId, archivedAt, status])
  @@index([assignedOperatorId])
}

// =========================================================================
// OPERATIONS — CUSTOMERS & PROJECTS
// =========================================================================

model Customer {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  name          String
  /// Short internal customer code (e.g. "CUST-004"), unique per company
  /// when set. Distinct from `name` — two customers may legitimately share
  /// a display name, so name uniqueness is checked at the application
  /// layer (active customers only), never enforced as a DB constraint.
  customerCode  String?
  contactPerson String?
  phone         String?
  email         String?
  /// Billing address for invoices/statements.
  address       String?
  gstNumber     String?
  /// Free-text payment terms shown on invoices (e.g. "50% advance, balance
  /// on completion"). Distinct from `defaultDueDays`, which drives the
  /// actual computed due date.
  paymentTerms   String?
  defaultDueDays Int?      @default(30)
  notes         String?
  isActive      Boolean   @default(true)
  archivedAt    DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects          Project[]
  invoices          Invoice[]
  payments          Payment[]
  billingDrafts     BillingDraft[]
  ledgerAdjustments LedgerAdjustment[]

  @@unique([companyId, customerCode])
  @@index([companyId])
}

/// A project belongs to one customer but may use many vehicles over its
/// lifetime (see ProjectVehicleAssignment) — never assume 1 project = 1
/// permanently assigned vehicle.
model Project {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  name         String
  code         String?
  siteLocation String?
  status       ProjectStatus @default(UPCOMING)
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  archivedAt   DateTime?
  createdById  String?
  updatedById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  vehicleAssignments ProjectVehicleAssignment[]
  dailyLogs          DailyLog[]
  fuelEntries        FuelEntry[]
  expenses           Expense[]
  invoices           Invoice[]
  billingConfig      BillingConfiguration?
  billingDrafts      BillingDraft[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
}

/// A vehicle may be assigned to a project for a period, then reassigned
/// elsewhere. Historical rows are retained (not overwritten) so a vehicle's
/// project history remains queryable.
model ProjectVehicleAssignment {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])
  assignedFrom DateTime  @default(now())
  assignedTo   DateTime?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
  @@index([vehicleId])
}

// =========================================================================
// DAILY OPERATIONS
// =========================================================================

model DailyLog {
  id               String         @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])
  projectId        String?
  project          Project?       @relation(fields: [projectId], references: [id])
  operatorId       String
  operator         User           @relation("DailyLogOperator", fields: [operatorId], references: [id])
  logDate          DateTime
  startHourMeter   Decimal?       @db.Decimal(12, 2)
  endHourMeter     Decimal?       @db.Decimal(12, 2)
  startOdometer    Decimal?       @db.Decimal(12, 2)
  endOdometer      Decimal?       @db.Decimal(12, 2)
  /// Server-computed = endHourMeter - startHourMeter. Never trust a
  /// client-supplied value for this.
  workingHours     Decimal?       @db.Decimal(6, 2)
  idleHours        Decimal?       @db.Decimal(6, 2)
  /// Server-computed = endOdometer - startOdometer.
  distance         Decimal?       @db.Decimal(12, 2)
  workDescription  String?
  breakdownNotes   String?
  remarks          String?
  /// Set server-side when working hours/distance exceed a configured
  /// sanity threshold — surfaced for review, never silently dropped or
  /// silently blocked. See src/lib/business/daily-log.ts.
  flaggedForReview Boolean        @default(false)
  flagReason       String?
  meterPhotoFileId String?
  meterPhoto       FileAsset?     @relation("DailyLogMeterPhoto", fields: [meterPhotoFileId], references: [id])
  sitePhotoFileId  String?
  sitePhoto        FileAsset?     @relation("DailyLogSitePhoto", fields: [sitePhotoFileId], references: [id])
  status           ApprovalStatus @default(SUBMITTED)
  createdById      String?
  updatedById      String?
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  billingSourceLogs BillingDraftSourceLog[]

  // Compound indexes match the actual query shape: chronology lookups and
  // history views always filter by vehicleId/operatorId together with a
  // date comparison or ordering, not logDate alone.
  @@index([vehicleId, logDate])
  @@index([operatorId, logDate])
  @@index([projectId])
}

model FuelEntry {
  id             String    @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  entryDate      DateTime
  fuelType       FuelType  @default(DIESEL)
  quantityLiters Decimal   @db.Decimal(10, 2)
  ratePerLiter   Decimal   @db.Decimal(10, 2)
  totalCost      Decimal   @db.Decimal(12, 2)
  odometerAtFill Decimal?  @db.Decimal(12, 2)
  hourMeterAtFill Decimal? @db.Decimal(12, 2)
  vendorName     String?
  notes          String?
  receiptFileId  String?
  receipt        FileAsset? @relation("FuelReceipt", fields: [receiptFileId], references: [id])
  createdById    String?
  updatedById    String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([vehicleId, entryDate])
  @@index([projectId])
}

// =========================================================================
// EXPENSES
// =========================================================================

model ExpenseCategory {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expenses Expense[]

  @@unique([companyId, name])
}

model Expense {
  id             String          @id @default(cuid())
  vehicleId      String?
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id])
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount         Decimal         @db.Decimal(12, 2)
  expenseDate    DateTime
  description    String?
  vendorName     String?
  receiptFileId  String?
  receipt        FileAsset?      @relation("ExpenseReceipt", fields: [receiptFileId], references: [id])
  status         ExpenseStatus   @default(PENDING)
  submittedById  String
  submittedBy    User            @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id])
  /// Set on both approval and rejection — represents "reviewed by/at",
  /// not exclusively approval.
  approvedById   String?
  approvedBy     User?           @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  /// Rejection reason (required on reject) or an optional approval note.
  reviewNote     String?
  createdById    String?
  updatedById    String?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([vehicleId, expenseDate])
  @@index([status, expenseDate])
  @@index([projectId])
  @@index([categoryId])
}

// =========================================================================
// FINANCE — BILLING, INVOICES, PAYMENTS
// =========================================================================

model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])
  /// Set only when this invoice was generated from an approved
  /// BillingDraft — the unique constraint is what makes duplicate
  /// invoice generation from the same draft impossible at the DB level,
  /// on top of the transactional status guard in the action layer.
  billingDraftId String?      @unique
  billingDraft   BillingDraft? @relation("BillingDraftInvoice", fields: [billingDraftId], references: [id])
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime?
  /// Billing period this invoice covers, when generated from billing
  /// (mirrors BillingDraft.periodStart/periodEnd) — null for manual
  /// ad-hoc invoices with no associated period.
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  currency      String        @default("INR")
  subtotal      Decimal       @db.Decimal(12, 2) @default(0)
  discountAmount Decimal      @db.Decimal(12, 2) @default(0)
  taxAmount     Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount   Decimal       @db.Decimal(12, 2) @default(0)
  /// Maintained aggregate of allocated payments — recomputed from
  /// PaymentAllocation inside the same transaction on every allocation
  /// change, never set independently. The true source of truth for
  /// "outstanding" is always Invoice.totalAmount minus allocations,
  /// derived at read time; this column exists only to avoid an aggregate
  /// join on every list view.
  amountPaid    Decimal       @db.Decimal(12, 2) @default(0)
  notes         String?
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?         @relation("InvoiceApprovedBy", fields: [approvedById], references: [id])
  sentAt        DateTime?
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?         @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  cancellationReason String?
  createdById   String?
  updatedById   String?
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines               InvoiceLine[]
  paymentAllocations  PaymentAllocation[]

  @@unique([companyId, invoiceNumber])
  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@index([companyId, dueDate])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  description String
  quantity    Decimal  @db.Decimal(10, 2) @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  /// Pre-tax line total = quantity * unitPrice, snapshotted at creation —
  /// never recomputed from current project/billing rates afterward.
  amount      Decimal  @db.Decimal(12, 2)
  taxPercent  Decimal  @db.Decimal(5, 2) @default(0)
  taxAmount   Decimal  @db.Decimal(12, 2) @default(0)
  /// Where this line came from, for traceability — e.g. "BILLING_DRAFT",
  /// "MOBILISATION", "DEMOBILISATION", "ADDITIONAL_CHARGE", "MANUAL".
  sourceType  String?
  sourceId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
  @@index([vehicleId])
}

model Payment {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  paymentDate     DateTime
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?
  receivedById    String?
  receivedBy      User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledBy     User?         @relation("PaymentCancelledBy", fields: [cancelledById], references: [id])
  cancellationReason String?
  createdById     String?
  updatedById     String?
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([paymentDate])
}

/// Supports partial payments against one or many invoices. A payment's
/// unallocated remainder = payment.amount - sum(allocations.amountAllocated).
model PaymentAllocation {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  amountAllocated Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

/// Concurrency-safe invoice number counter, one row per company per
/// fiscal year (Indian FY: April-March; see src/lib/business/invoice.ts).
/// Numbers are issued via an atomic `INSERT ... ON CONFLICT DO UPDATE
/// SET lastNumber = lastNumber + 1 RETURNING lastNumber` — never read
/// then written as two steps, and never generated client-side.
model InvoiceSequence {
  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  fiscalYear Int
  lastNumber Int     @default(0)

  @@id([companyId, fiscalYear])
}

/// A project's billing terms. Mutable — editing it changes how FUTURE
/// billing drafts are calculated, but every past BillingDraft/Invoice has
/// already snapshotted its own rate/quantity/amounts, so a rate change
/// here never rewrites billing history.
model BillingConfiguration {
  id                     String      @id @default(cuid())
  projectId              String      @unique
  project                Project     @relation(fields: [projectId], references: [id])
  billingType            BillingType
  /// Per-hour / per-day / per-month rate, or the agreed lump sum for FIXED.
  baseRate               Decimal     @db.Decimal(12, 2)
  /// HOURLY only: if a day's actual working hours are below this, that
  /// day is still billed for this many hours.
  minimumGuaranteedHours Decimal?    @db.Decimal(6, 2)
  /// HOURLY only: hours worked beyond this many in a single day are
  /// billed at overtimeRate instead of baseRate. Both must be set
  /// together for overtime to apply.
  overtimeThresholdHours Decimal?    @db.Decimal(6, 2)
  overtimeRate           Decimal?    @db.Decimal(12, 2)
  mobilisationCharge     Decimal?    @db.Decimal(12, 2)
  demobilisationCharge   Decimal?    @db.Decimal(12, 2)
  taxPercent             Decimal     @db.Decimal(5, 2) @default(0)
  billingNotes           String?
  createdById            String?
  updatedById            String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

/// Billing Preparation / Billing Draft: the reviewable, approvable
/// staging record between raw operational data and an issued Invoice.
/// Every field here is a snapshot taken at calculation/approval time —
/// generating the eventual Invoice copies these values verbatim rather
/// than re-deriving them from the (possibly since-changed) project/
/// billing configuration.
model BillingDraft {
  id             String             @id @default(cuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id])
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id])
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id])
  billingType    BillingType
  periodStart    DateTime
  periodEnd      DateTime
  status         BillingDraftStatus @default(DRAFT)
  /// Hours (HOURLY), eligible days (DAILY), or 1 (MONTHLY/FIXED).
  quantity       Decimal            @db.Decimal(12, 2)
  rate           Decimal            @db.Decimal(12, 2)
  baseAmount     Decimal            @db.Decimal(12, 2)
  additionalChargesAmount Decimal   @db.Decimal(12, 2) @default(0)
  taxPercent     Decimal            @db.Decimal(5, 2) @default(0)
  taxAmount      Decimal            @db.Decimal(12, 2) @default(0)
  totalAmount    Decimal            @db.Decimal(12, 2)
  /// Full calculation breakdown (normal/overtime hours, minimum-guarantee
  /// application, eligible-day list, etc.) — kept for drill-down/audit
  /// even though the summary fields above are also persisted directly.
  calculationDetail Json?
  notes          String?
  /// Set on both approval and rejection — "reviewed by/at", matching the
  /// Expense.approvedBy convention elsewhere in this codebase.
  reviewNote     String?
  reviewedById   String?
  reviewedBy     User?              @relation("BillingDraftReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  charges    BillingDraftCharge[]
  sourceLogs BillingDraftSourceLog[]
  invoice    Invoice?                @relation("BillingDraftInvoice")

  @@index([companyId])
  @@index([projectId])
  @@index([customerId])
  @@index([status])
}

/// Ad-hoc charges added during billing review (mobilisation,
/// demobilisation, other approved extras) — distinct from the recurring
/// rate captured in baseAmount.
model BillingDraftCharge {
  id             String       @id @default(cuid())
  billingDraftId String
  billingDraft   BillingDraft @relation(fields: [billingDraftId], references: [id], onDelete: Cascade)
  description    String
  amount         Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())

  @@index([billingDraftId])
}

/// Links a BillingDraft to the specific DailyLog rows its HOURLY/DAILY
/// calculation was derived from, so a reviewer can drill down into the
/// exact source records rather than trusting an opaque total.
model BillingDraftSourceLog {
  id             String       @id @default(cuid())
  billingDraftId String
  billingDraft   BillingDraft @relation(fields: [billingDraftId], references: [id], onDelete: Cascade)
  dailyLogId     String
  dailyLog       DailyLog     @relation(fields: [dailyLogId], references: [id])
  /// HOURLY: the billable hours counted from this log (after minimum-
  /// guarantee/overtime rules). DAILY: null — the log simply marks the
  /// day as eligible.
  hoursCounted   Decimal?     @db.Decimal(6, 2)
  createdAt      DateTime     @default(now())

  @@unique([billingDraftId, dailyLogId])
  @@index([dailyLogId])
}

/// An explicit, authorized correction to a customer's derived balance —
/// e.g. a write-off or a manually-issued credit. Never a raw balance
/// edit: always signed (DEBIT/CREDIT), reasoned, attributed, and audited.
/// Included as one more line in the customer ledger alongside invoices
/// and payments (see src/lib/business/ledger.ts).
model LedgerAdjustment {
  id          String               @id @default(cuid())
  companyId   String
  company     Company              @relation(fields: [companyId], references: [id])
  customerId  String
  customer    Customer             @relation(fields: [customerId], references: [id])
  type        LedgerAdjustmentType
  amount      Decimal              @db.Decimal(12, 2)
  reason      String
  createdById String
  createdBy   User                 @relation("LedgerAdjustmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())

  @@index([companyId])
  @@index([customerId])
}

// =========================================================================
// MAINTENANCE & DOCUMENTS
// =========================================================================

model MaintenanceRecord {
  id                  String          @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle         @relation(fields: [vehicleId], references: [id])
  type                MaintenanceType @default(SCHEDULED)
  title               String
  description         String?
  serviceDate         DateTime
  cost                Decimal?        @db.Decimal(12, 2)
  vendorName          String?
  odometerAtService   Decimal?        @db.Decimal(12, 2)
  hourMeterAtService  Decimal?        @db.Decimal(12, 2)
  nextDueDate         DateTime?
  nextDueOdometer     Decimal?        @db.Decimal(12, 2)
  nextDueHourMeter    Decimal?        @db.Decimal(12, 2)
  createdById         String?
  updatedById         String?
  archivedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([vehicleId])
  @@index([serviceDate])
}

model VehicleDocument {
  id             String              @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle             @relation(fields: [vehicleId], references: [id])
  type           VehicleDocumentType @default(OTHER)
  title          String
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  fileAssetId    String?
  fileAsset      FileAsset?          @relation(fields: [fileAssetId], references: [id])
  createdById    String?
  updatedById    String?
  archivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([vehicleId])
  @@index([expiryDate])
}

// =========================================================================
// FILE STORAGE
// =========================================================================

/// Metadata record for any uploaded file (receipts, photos, documents).
/// The actual bytes live behind the storage abstraction in
/// src/lib/storage — this row never stores a raw filesystem path supplied
/// by a client.
model FileAsset {
  id               String   @id @default(cuid())
  storageProvider  String
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  uploadedById     String?
  uploadedBy       User?    @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  createdAt        DateTime @default(now())

  vehicleDocuments   VehicleDocument[]
  vehicleImages      Vehicle[]         @relation("VehicleImage")
  dailyLogMeterPhotos DailyLog[]       @relation("DailyLogMeterPhoto")
  dailyLogSitePhotos  DailyLog[]       @relation("DailyLogSitePhoto")
  fuelReceipts        FuelEntry[]      @relation("FuelReceipt")
  expenseReceipts      Expense[]        @relation("ExpenseReceipt")

  @@index([uploadedById])
}

// =========================================================================
// MONTHLY CLOSING / PERIOD LOCKS (Phase 2.5)
// =========================================================================

/// OPEN -> REVIEW -> CLOSED -> REOPENED -> (REVIEW or CLOSED again). See
/// src/lib/business/closing-period.ts for the exact transition rules.
/// REOPENED behaves like OPEN for lock-enforcement purposes (see
/// src/lib/data/period-lock.ts) — only CLOSED blocks mutations.
enum ClosingPeriodStatus {
  OPEN
  REVIEW
  CLOSED
  REOPENED
}

/// One row per company per accounting month. Its existence (or absence)
/// is the single source of truth for whether records dated within
/// [startDate, endDate] may be mutated — see
/// src/lib/data/period-lock.ts#assertPeriodNotLocked, which every
/// date-bearing financial/operational mutation (DailyLog, FuelEntry,
/// Expense, Invoice, Payment, PaymentAllocation) calls before writing.
/// A month with no ClosingPeriod row is implicitly OPEN/unlocked.
model ClosingPeriod {
  id         String              @id @default(cuid())
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id])
  year       Int
  /// 1-12, business-timezone (Asia/Kolkata) calendar month.
  month      Int
  /// Both boundaries are plain calendar-date instants (UTC midnight of
  /// the 1st, and 23:59:59.999 of the last day) — matching how every
  /// date-only field this locks against (DailyLog.logDate,
  /// Invoice.issueDate, etc.) is itself stored. See
  /// src/lib/business/business-time.ts#calendarMonthRange.
  startDate  DateTime
  endDate    DateTime
  status     ClosingPeriodStatus @default(OPEN)
  notes      String?
  /// Required when closing despite outstanding (non-blocking) warnings;
  /// null when the month closed with a clean checklist.
  overrideReason String?
  closedAt     DateTime?
  closedById   String?
  closedBy     User?     @relation("ClosingPeriodClosedBy", fields: [closedById], references: [id])
  reopenedAt   DateTime?
  reopenedById String?
  reopenedBy   User?     @relation("ClosingPeriodReopenedBy", fields: [reopenedById], references: [id])
  /// Required every time the period is reopened — never automatic.
  reopenReason String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([companyId, year, month])
  @@index([companyId, status])
  @@index([companyId, startDate, endDate])
}

// =========================================================================
// AUDIT & NOTIFICATIONS
// =========================================================================

/// Immutable record of sensitive server-side actions. Never store
/// passwords, tokens, or secrets in beforeValue/afterValue.
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  reason     String?
  beforeValue Json?
  afterValue  Json?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id                 String           @id @default(cuid())
  recipientId        String
  recipient          User             @relation(fields: [recipientId], references: [id])
  type               NotificationType @default(GENERAL)
  title              String
  message            String
  relatedEntityType  String?
  relatedEntityId    String?
  readAt             DateTime?
  createdAt          DateTime         @default(now())

  @@index([recipientId])
  @@index([readAt])
}
