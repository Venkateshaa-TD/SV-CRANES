// FleetView — Crane & Fleet Operations Management System
// Foundation schema. Later-phase models exist to establish relationships;
// their full workflows (billing engine, maintenance workflow, etc.) are
// deliberately not implemented yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer, transaction mode) connection — used by the running
  // app and by Prisma Client generally. Supabase's session-mode pooler
  // caps concurrent connections low (commonly 15), which the app can
  // exhaust on its own; the transaction pooler is built for many short
  // lived connections instead.
  url       = env("DATABASE_URL")
  // Direct/session connection — used only for schema migrations, which
  // need a non-pooled (or session-mode) connection.
  directUrl = env("DIRECT_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum UserRole {
  SUPER_ADMIN
  MANAGER
  ACCOUNTANT
  SUPERVISOR
  OPERATOR
}

enum VehicleStatus {
  WORKING
  IDLE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum VehicleCategory {
  CRANE
  TRUCK
  TRAILER
  PICKUP
  OTHER
}

enum ProjectStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Generic submit/review workflow status used by records that require
/// supervisor or manager approval before they affect reports/billing.
enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  CARD
  OTHER
}

enum MaintenanceType {
  SCHEDULED
  BREAKDOWN
  INSPECTION
  OTHER
}

enum VehicleDocumentType {
  REGISTRATION
  INSURANCE
  FITNESS_CERTIFICATE
  PERMIT
  PUC
  OTHER
}

enum FuelType {
  DIESEL
  PETROL
  OTHER
}

enum NotificationType {
  GENERAL
  APPROVAL_REQUEST
  ALERT
  REMINDER
}

// =========================================================================
// COMPANY / TENANT
// =========================================================================

/// Single company today; modelled as a row (not hardcoded) so the schema
/// does not need to be redesigned if a second entity is ever added.
model Company {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  vehicles          Vehicle[]
  customers         Customer[]
  projects          Project[]
  expenseCategories ExpenseCategory[]
  invoices          Invoice[]
  payments          Payment[]
  auditLogs         AuditLog[]
}

// =========================================================================
// AUTH — USERS, ROLES, PERMISSIONS
// =========================================================================

model User {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  /// Optional short staff code (e.g. "OP-04"), unique per company.
  employeeCode String?
  role         UserRole
  isActive     Boolean   @default(true)
  image        String?
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  permissionOverrides UserPermission[]
  notifications       Notification[]
  auditLogs           AuditLog[]         @relation("AuditActor")
  fileAssets          FileAsset[]        @relation("FileUploadedBy")

  // Reverse relations for createdBy/updatedBy tracking are intentionally
  // omitted from User to avoid dozens of unnamed back-relations; the
  // createdById/updatedById fields below are plain string FKs (nullable)
  // recorded for audit purposes without forcing relational fan-out here.

  operatedDailyLogs DailyLog[]         @relation("DailyLogOperator")
  submittedExpenses Expense[]          @relation("ExpenseSubmittedBy")
  approvedExpenses  Expense[]          @relation("ExpenseApprovedBy")
  receivedPayments  Payment[]          @relation("PaymentReceivedBy")
  /// Vehicles this operator is the current primary assignee for. Assigned
  /// from the vehicle side (Vehicle.assignedOperatorId) — not editable here.
  assignedVehicles  Vehicle[]          @relation("VehicleAssignedOperator")

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([role])
}

/// Individual permission grant/revoke, layered on top of the role's default
/// permission set. Enables per-user exceptions (e.g. a small number of
/// users who may edit customer financial data) without hardcoding names or
/// forking role logic. See src/lib/auth/permissions.ts for the permission
/// key catalogue and how overrides are combined with role defaults.
model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  granted    Boolean  @default(true)
  reason     String?
  createdById String?
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

// =========================================================================
// FLEET
// =========================================================================

model Vehicle {
  id                 String          @id @default(cuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id])
  /// Short internal fleet code (e.g. "CR-01"), distinct from the display
  /// name and the government registration number.
  code               String?
  name               String
  registrationNumber String          @unique
  category           VehicleCategory @default(OTHER)
  capacityTons       Decimal?        @db.Decimal(10, 2)
  make               String?
  model              String?
  year               Int?
  fuelType           FuelType?
  status             VehicleStatus   @default(IDLE)
  /// Denormalized "latest known" readings. Advanced only via a MAX-style
  /// update alongside DailyLog creation (see src/lib/business/daily-log.ts)
  /// so a backdated historical log can never move these backwards.
  currentOdometer    Decimal?        @db.Decimal(12, 2)
  currentHourMeter   Decimal?        @db.Decimal(12, 2)
  assignedOperatorId String?
  assignedOperator   User?           @relation("VehicleAssignedOperator", fields: [assignedOperatorId], references: [id])
  purchaseDate       DateTime?
  purchaseAmount     Decimal?        @db.Decimal(12, 2)
  imageFileId        String?
  image              FileAsset?      @relation("VehicleImage", fields: [imageFileId], references: [id])
  notes              String?
  isActive           Boolean         @default(true)
  archivedAt         DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  projectAssignments ProjectVehicleAssignment[]
  dailyLogs          DailyLog[]
  fuelEntries        FuelEntry[]
  expenses           Expense[]
  maintenanceRecords MaintenanceRecord[]
  documents          VehicleDocument[]
  invoiceLines       InvoiceLine[]

  @@unique([companyId, code])
  // Nearly every vehicle list/dashboard query filters by companyId and
  // archivedAt (active vs archived) together, often with status too.
  @@index([companyId, archivedAt, status])
  @@index([assignedOperatorId])
}

// =========================================================================
// OPERATIONS — CUSTOMERS & PROJECTS
// =========================================================================

model Customer {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  notes         String?
  isActive      Boolean   @default(true)
  archivedAt    DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects Project[]
  invoices Invoice[]
  payments Payment[]

  @@index([companyId])
}

/// A project belongs to one customer but may use many vehicles over its
/// lifetime (see ProjectVehicleAssignment) — never assume 1 project = 1
/// permanently assigned vehicle.
model Project {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  name         String
  code         String?
  siteLocation String?
  status       ProjectStatus @default(UPCOMING)
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  archivedAt   DateTime?
  createdById  String?
  updatedById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  vehicleAssignments ProjectVehicleAssignment[]
  dailyLogs          DailyLog[]
  fuelEntries        FuelEntry[]
  expenses           Expense[]
  invoices           Invoice[]

  @@index([companyId])
  @@index([customerId])
  @@index([status])
}

/// A vehicle may be assigned to a project for a period, then reassigned
/// elsewhere. Historical rows are retained (not overwritten) so a vehicle's
/// project history remains queryable.
model ProjectVehicleAssignment {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])
  assignedFrom DateTime  @default(now())
  assignedTo   DateTime?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
  @@index([vehicleId])
}

// =========================================================================
// DAILY OPERATIONS
// =========================================================================

model DailyLog {
  id               String         @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])
  projectId        String?
  project          Project?       @relation(fields: [projectId], references: [id])
  operatorId       String
  operator         User           @relation("DailyLogOperator", fields: [operatorId], references: [id])
  logDate          DateTime
  startHourMeter   Decimal?       @db.Decimal(12, 2)
  endHourMeter     Decimal?       @db.Decimal(12, 2)
  startOdometer    Decimal?       @db.Decimal(12, 2)
  endOdometer      Decimal?       @db.Decimal(12, 2)
  /// Server-computed = endHourMeter - startHourMeter. Never trust a
  /// client-supplied value for this.
  workingHours     Decimal?       @db.Decimal(6, 2)
  idleHours        Decimal?       @db.Decimal(6, 2)
  /// Server-computed = endOdometer - startOdometer.
  distance         Decimal?       @db.Decimal(12, 2)
  workDescription  String?
  breakdownNotes   String?
  remarks          String?
  /// Set server-side when working hours/distance exceed a configured
  /// sanity threshold — surfaced for review, never silently dropped or
  /// silently blocked. See src/lib/business/daily-log.ts.
  flaggedForReview Boolean        @default(false)
  flagReason       String?
  meterPhotoFileId String?
  meterPhoto       FileAsset?     @relation("DailyLogMeterPhoto", fields: [meterPhotoFileId], references: [id])
  sitePhotoFileId  String?
  sitePhoto        FileAsset?     @relation("DailyLogSitePhoto", fields: [sitePhotoFileId], references: [id])
  status           ApprovalStatus @default(SUBMITTED)
  createdById      String?
  updatedById      String?
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Compound indexes match the actual query shape: chronology lookups and
  // history views always filter by vehicleId/operatorId together with a
  // date comparison or ordering, not logDate alone.
  @@index([vehicleId, logDate])
  @@index([operatorId, logDate])
  @@index([projectId])
}

model FuelEntry {
  id             String    @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id])
  entryDate      DateTime
  fuelType       FuelType  @default(DIESEL)
  quantityLiters Decimal   @db.Decimal(10, 2)
  ratePerLiter   Decimal   @db.Decimal(10, 2)
  totalCost      Decimal   @db.Decimal(12, 2)
  odometerAtFill Decimal?  @db.Decimal(12, 2)
  hourMeterAtFill Decimal? @db.Decimal(12, 2)
  vendorName     String?
  notes          String?
  receiptFileId  String?
  receipt        FileAsset? @relation("FuelReceipt", fields: [receiptFileId], references: [id])
  createdById    String?
  updatedById    String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([vehicleId, entryDate])
  @@index([projectId])
}

// =========================================================================
// EXPENSES
// =========================================================================

model ExpenseCategory {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expenses Expense[]

  @@unique([companyId, name])
}

model Expense {
  id             String          @id @default(cuid())
  vehicleId      String?
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id])
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount         Decimal         @db.Decimal(12, 2)
  expenseDate    DateTime
  description    String?
  vendorName     String?
  receiptFileId  String?
  receipt        FileAsset?      @relation("ExpenseReceipt", fields: [receiptFileId], references: [id])
  status         ExpenseStatus   @default(PENDING)
  submittedById  String
  submittedBy    User            @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id])
  /// Set on both approval and rejection — represents "reviewed by/at",
  /// not exclusively approval.
  approvedById   String?
  approvedBy     User?           @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  /// Rejection reason (required on reject) or an optional approval note.
  reviewNote     String?
  createdById    String?
  updatedById    String?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([vehicleId, expenseDate])
  @@index([status, expenseDate])
  @@index([projectId])
  @@index([categoryId])
}

// =========================================================================
// FINANCE — BILLING, INVOICES, PAYMENTS
// =========================================================================

model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime?
  subtotal      Decimal       @db.Decimal(12, 2) @default(0)
  taxAmount     Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount   Decimal       @db.Decimal(12, 2) @default(0)
  amountPaid    Decimal       @db.Decimal(12, 2) @default(0)
  notes         String?
  createdById   String?
  updatedById   String?
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines               InvoiceLine[]
  paymentAllocations  PaymentAllocation[]

  @@unique([companyId, invoiceNumber])
  @@index([customerId])
  @@index([projectId])
  @@index([status])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  description String
  quantity    Decimal  @db.Decimal(10, 2) @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
  @@index([vehicleId])
}

model Payment {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  paymentDate     DateTime
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?
  receivedById    String?
  receivedBy      User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  createdById     String?
  updatedById     String?
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([paymentDate])
}

/// Supports partial payments against one or many invoices. A payment's
/// unallocated remainder = payment.amount - sum(allocations.amountAllocated).
model PaymentAllocation {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  amountAllocated Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

// =========================================================================
// MAINTENANCE & DOCUMENTS
// =========================================================================

model MaintenanceRecord {
  id                  String          @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle         @relation(fields: [vehicleId], references: [id])
  type                MaintenanceType @default(SCHEDULED)
  title               String
  description         String?
  serviceDate         DateTime
  cost                Decimal?        @db.Decimal(12, 2)
  vendorName          String?
  odometerAtService   Decimal?        @db.Decimal(12, 2)
  hourMeterAtService  Decimal?        @db.Decimal(12, 2)
  nextDueDate         DateTime?
  nextDueOdometer     Decimal?        @db.Decimal(12, 2)
  nextDueHourMeter    Decimal?        @db.Decimal(12, 2)
  createdById         String?
  updatedById         String?
  archivedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([vehicleId])
  @@index([serviceDate])
}

model VehicleDocument {
  id             String              @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle             @relation(fields: [vehicleId], references: [id])
  type           VehicleDocumentType @default(OTHER)
  title          String
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  fileAssetId    String?
  fileAsset      FileAsset?          @relation(fields: [fileAssetId], references: [id])
  createdById    String?
  updatedById    String?
  archivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([vehicleId])
  @@index([expiryDate])
}

// =========================================================================
// FILE STORAGE
// =========================================================================

/// Metadata record for any uploaded file (receipts, photos, documents).
/// The actual bytes live behind the storage abstraction in
/// src/lib/storage — this row never stores a raw filesystem path supplied
/// by a client.
model FileAsset {
  id               String   @id @default(cuid())
  storageProvider  String
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  uploadedById     String?
  uploadedBy       User?    @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  createdAt        DateTime @default(now())

  vehicleDocuments   VehicleDocument[]
  vehicleImages      Vehicle[]         @relation("VehicleImage")
  dailyLogMeterPhotos DailyLog[]       @relation("DailyLogMeterPhoto")
  dailyLogSitePhotos  DailyLog[]       @relation("DailyLogSitePhoto")
  fuelReceipts        FuelEntry[]      @relation("FuelReceipt")
  expenseReceipts      Expense[]        @relation("ExpenseReceipt")

  @@index([uploadedById])
}

// =========================================================================
// AUDIT & NOTIFICATIONS
// =========================================================================

/// Immutable record of sensitive server-side actions. Never store
/// passwords, tokens, or secrets in beforeValue/afterValue.
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  reason     String?
  beforeValue Json?
  afterValue  Json?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id                 String           @id @default(cuid())
  recipientId        String
  recipient          User             @relation(fields: [recipientId], references: [id])
  type               NotificationType @default(GENERAL)
  title              String
  message            String
  relatedEntityType  String?
  relatedEntityId    String?
  readAt             DateTime?
  createdAt          DateTime         @default(now())

  @@index([recipientId])
  @@index([readAt])
}
